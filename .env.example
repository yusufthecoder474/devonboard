# Copy to .env: cp .env.example .env
DATABASE_URL=postgresql://devonboard:devonboard@localhost:5432/devonboard?schema=public
# Required in production (NODE_ENV=production): the API refuses to start
# without it. Default value below is for local demo only — replace it
# with a long random secret before any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
